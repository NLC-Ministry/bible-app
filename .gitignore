# 本機環境變數與敏感資訊
.env
config.js


# 系統暫存與編輯器檔案
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
node_modules/

# 測試/虛擬資料檔案 (本地隔離)
mock_stats.js
demo_data_seed.sql
demo_data_seed_compact.sql
supabase/delete_demo_data.sql

# Superpowers SDD scratch (ledger, briefs, reports)
.superpowers/
.worktrees/
scratch/

# Build output (generated by scripts/bundle.mjs)
dist/

# Supabase CLI local state (link target, CLI version cache). Never commit:
# a committed link would point every contributor's `--linked` command at one project.
supabase/.temp/
supabase/.branches/

# Staging sample data exports (scripts/staging-sample-data.mjs). Anonymized but
# still derived from member activity; never commit.
staging-sample*.json
