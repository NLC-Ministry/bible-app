# 本機環境變數與敏感資訊
.env
config.js


# 系統暫存與編輯器檔案
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
node_modules/

# 測試/虛擬資料檔案 (本地隔離)
mock_stats.js
demo_data_seed.sql
demo_data_seed_compact.sql
supabase/delete_demo_data.sql

# Superpowers SDD scratch (ledger, briefs, reports)
.superpowers/
.worktrees/
scratch/

# Build output (generated by scripts/bundle.mjs; dist-admin/ by scripts/build-admin.mjs)
dist/
dist-admin/

# Supabase CLI local state (link target, CLI version cache). Never commit:
# a committed link would point every contributor's `--linked` command at one project.
supabase/.temp/
supabase/.branches/

# 經文注釋匯入的翻譯參考資料快取與翻譯輸入檔（scripts/commentary-import/，#542）：
# 信望愛 Strong's、當代譯本、Strong's 詞典只當翻譯參考，不散布。
.cache/

# Staging sample data exports (scripts/staging-sample-data.mjs). Anonymized but
# still derived from member activity; never commit.
staging-sample*.json

# 各 AI 工具的本機設定複本（含 skill 複本，不提交，#609）
.agents/
.codex/
