                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    },
                    {
                        "source":  "/read.html",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-cache, must-revalidate, proxy-revalidate, max-age=0"
                                        }
                                    ]
                    },
                    {
                        "source":  "/read",
